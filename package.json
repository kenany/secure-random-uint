{
  "name": "secure-random-uint",
  "version": "5.0.2",
  "description": "Generate a cryptographically secure uint",
  "keywords": [
    "crypto"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenany/secure-random-uint.git"
  },
  "license": "MIT",
  "author": "Kenan Yildirim <kenan@kenany.me> (https://kenany.me/)",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "types": "dist/index.d.cts",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.cjs": {
      "default": "./dist/*.cjs"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "scripts": {
    "build": "tsdown && tsc --noEmit",
    "lint": "biome check",
    "release": "semantic-release",
    "test": "vitest run",
    "publint": "publint --strict",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "get-random-values": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@kenan/biome-config": "1.0.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "publint": "0.3.24",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
